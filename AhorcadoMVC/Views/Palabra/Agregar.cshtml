@model AhorcadoMVC.Data.AhorcadoMVC.Models.Palabra

@{
    ViewBag.Title = "Agregar Palabra";
}

<h2>Agregar palabra al diccionario</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@using (Html.BeginForm())
{
    <div class="form-group">
        @Html.LabelFor(m => m.palabra)
        @Html.TextBoxFor(m => m.palabra, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.palabra, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
}