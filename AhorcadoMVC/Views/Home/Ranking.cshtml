@model IEnumerable<AhorcadoMVC.Models.RankingItemViewModel>

<table class="escalafon">
    <thead>
        <tr>
            <th>Identificación</th>
            <th>Nombre</th>
            <th>Marcador</th>
            <th>|</th>
            <th>Ganadas</th>
            <th>Perdidas</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var r in Model)
            {
                <tr>
                    <td>@r.IdJugador</td>
                    <td>@r.Nombre</td>
                    <td>@r.Marcador</td>
                    <td>|</td>
                    <td>@r.Ganadas</td>
                    <td>@r.Perdidas</td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="6">Sin datos aún.</td></tr>
        }
    </tbody>
</table>
